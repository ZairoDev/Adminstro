# CRM Copilot (internal staff assistant)
# Kill switch — leave false in production until pilot
CRM_AGENT_ENABLED=false
# Comma-separated roles allowed when enabled
CRM_AGENT_PILOT_ROLES=SuperAdmin,Sales-TeamLead,HR
# Agent write workflows (disposition / reminders). Ask stays open to pilot roles.
CRM_AGENT_WRITE_ROLES=SuperAdmin,Sales-TeamLead
# Groq chat (https://console.groq.com)
GROQ_API_KEY=
# Examples: llama-3.3-70b-versatile, llama-3.1-8b-instant
CRM_AGENT_MODEL=openai/gpt-oss-120b
# Playbook RAG uses local embeddings (no Google). Re-run: npm run crm-agent:index
CRM_AGENT_EMBED_MODEL=local-hash-384
